{
  "name": "blockless-pcb-studio",
  "version": "0.1.0",
  "description": "A modular PCB backplane planner with browser previews and an optional KiCad autorouting workflow.",
  "private": true,
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FreakStudioCN/blockless-pcb-studio.git"
  },
  "homepage": "https://github.com/FreakStudioCN/blockless-pcb-studio#readme",
  "bugs": {
    "url": "https://github.com/FreakStudioCN/blockless-pcb-studio/issues"
  },
  "keywords": [
    "pcb",
    "kicad",
    "eda",
    "autorouting",
    "hardware"
  ],
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "harvest:assets": "node scripts/harvest-real-cad.mjs",
    "kicad:plans": "node scripts/run-python.mjs kicad-host-mvp/scripts/generate_plan.py",
    "kicad:validate": "node scripts/run-python.mjs kicad-host-mvp/scripts/validate_plans.py",
    "kicad:check": "node scripts/run-python.mjs kicad-host-mvp/scripts/kicad_host.py check",
    "kicad:setup-router": "node scripts/run-python.mjs kicad-host-mvp/scripts/kicad_host.py setup-router",
    "kicad:build": "node scripts/run-python.mjs kicad-host-mvp/scripts/kicad_host.py build",
    "kicad:ai-route": "node scripts/run-python.mjs kicad-host-mvp/scripts/kicad_host.py route",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "test:ui": "playwright test",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "jszip": "^3.10.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.171.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.1.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.171.0",
    "typescript": "^5.6.3",
    "vite": "^6.0.1"
  }
}
